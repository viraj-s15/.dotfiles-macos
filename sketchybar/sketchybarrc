#!/bin/bash

source "$HOME/.config/sketchybar/colors.sh"
source "$HOME/.config/sketchybar/icons.sh"

ITEM_DIR="$HOME/.config/sketchybar/items"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

BRIGHTNESS_HELPER="$HOME/.config/sketchybar/helper/brightnessctl"
BRIGHTNESS_SOURCE="$HOME/.config/sketchybar/helper/brightness.swift"
if [ ! -x "$BRIGHTNESS_HELPER" ] || [ "$BRIGHTNESS_SOURCE" -nt "$BRIGHTNESS_HELPER" ]; then
  swiftc -F /System/Library/PrivateFrameworks \
         -framework DisplayServices \
         "$BRIGHTNESS_SOURCE" \
         -o "$BRIGHTNESS_HELPER"
fi

FONT="SF Pro"
PADDINGS=3

# Optional widgets. Change any value to true and reload SketchyBar to restore it.
ENABLE_SPOTIFY=false
ENABLE_BRIGHTNESS=false
ENABLE_VOLUME=false
ENABLE_AEROSPACE_LAYOUT=false
ENABLE_WORKSPACE_SEPARATOR=true
ENABLE_SYSTEM_METRICS=true
ENABLE_GITHUB=false
ENABLE_NOTIFICATIONS=true
ENABLE_FOCUS=true

NOTIFICATION_CENTER_HELPER="$HOME/.config/sketchybar/helper/notification-center"
NOTIFICATION_CENTER_SOURCE="$HOME/.config/sketchybar/helper/notification-center.swift"
if [ "$ENABLE_NOTIFICATIONS" = true ] && { [ ! -x "$NOTIFICATION_CENTER_HELPER" ] || [ "$NOTIFICATION_CENTER_SOURCE" -nt "$NOTIFICATION_CENTER_HELPER" ]; }; then
  swiftc "$NOTIFICATION_CENTER_SOURCE" -o "$NOTIFICATION_CENTER_HELPER"
fi

bar=(
  height=29
  color=$TRANSPARENT
  shadow=off
  position=top
  sticky=on
  padding_right=10
  padding_left=10
  corner_radius=10
  y_offset=3
  margin=10
  blur_radius=0
  notch_width=280
)

sketchybar --bar "${bar[@]}"

defaults=(
  updates=when_shown
  icon.font="$FONT:Bold:15.0"
  icon.color=$ICON_COLOR
  icon.padding_left=$PADDINGS
  icon.padding_right=$PADDINGS
  label.font="$FONT:Semibold:13.0"
  label.color=$LABEL_COLOR
  label.padding_left=$PADDINGS
  label.padding_right=$PADDINGS
  padding_right=$PADDINGS
  padding_left=$PADDINGS
  background.height=24
  background.corner_radius=9
  popup.background.border_width=2
  popup.background.corner_radius=9
  popup.background.border_color=$POPUP_BORDER_COLOR
  popup.background.color=$POPUP_BACKGROUND_COLOR
  popup.blur_radius=20
  popup.background.shadow.drawing=on
)

sketchybar --default "${defaults[@]}"

# Left
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
[ "$ENABLE_AEROSPACE_LAYOUT" = true ] && source "$ITEM_DIR/aerospace.sh"
source "$ITEM_DIR/front_app.sh"

# Right
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/brew.sh"
[ "$ENABLE_GITHUB" = true ] && source "$ITEM_DIR/github.sh"
[ "$ENABLE_NOTIFICATIONS" = true ] && source "$ITEM_DIR/notifications.sh"
[ "$ENABLE_FOCUS" = true ] && source "$ITEM_DIR/focus.sh"
source "$ITEM_DIR/battery.sh"
[ "$ENABLE_VOLUME" = true ] && source "$ITEM_DIR/volume.sh"
[ "$ENABLE_BRIGHTNESS" = true ] && source "$ITEM_DIR/brightness.sh"
[ "$ENABLE_SYSTEM_METRICS" = true ] && source "$ITEM_DIR/cpu.sh"
[ "$ENABLE_SYSTEM_METRICS" = true ] && source "$ITEM_DIR/memory.sh"
[ "$ENABLE_SPOTIFY" = true ] && source "$ITEM_DIR/spotify.sh"
source "$ITEM_DIR/bar_sections.sh"

# Forcing all item scripts to run (never do this outside of sketchybarrc)
sketchybar --update

echo "sketchybar configuration loaded"
