{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/Users/veer/.config/fastfetch/doctor.txt",
    "color": {
      "1": "light_blue"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": " : ",
    "brightColor": false
  },
  "modules": [
    {
      "type": "title",
      "format": "{#6}{user-name}{#}@{#5}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{#6}╭──────────── {#2}Software{#6} ────────────{#}"
    },
    {
      "type": "os",
      "key": "{#6}│ {#1} OS {#}",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "{#6}│ {#2} KER{#}",
      "format": "{release}"
    },
    {
      "type": "packages",
      "key": "{#6}│ {#3} PKG{#}",
      "format": "{brew} formulae, {brew-cask} casks"
    },
    {
      "type": "shell",
      "key": "{#6}│ {#4} SHL{#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "{#6}│ {#5} TER{#}",
      "format": "{pretty-name}"
    },
    {
      "type": "command",
      "key": "{#6}│ {#6} WM {#}",
      "text": "aerospace --version | head -1 | sed 's/aerospace CLI client version: /AeroSpace /; s/ [0-9a-f][0-9a-f]*$//'",
      "format": "{}"
    },
    {
      "type": "locale",
      "key": "{#6}│ {#1} LOC{#}"
    },
    {
      "type": "custom",
      "format": "{#6}├──────────── {#2}Hardware{#6} ────────────{#}"
    },
    {
      "type": "uptime",
      "key": "{#6}│ {#3} UPT{#}"
    },
    {
      "type": "host",
      "key": "{#6}│ {#4} HST{#}",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "{#6}│ {#5} CPU{#}",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "gpu",
      "key": "{#6}│ {#6} GPU{#}",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#6}│ {#1} MEM{#}",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "{#6}│ {#2} DSK{#}",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "battery",
      "key": "{#6}│ {#3} BAT{#}",
      "format": "{capacity} ({status})"
    },
    {
      "type": "custom",
      "format": "{#6}╰──────── {#0}󰝤 {#1}󰝤 {#2}󰝤 {#3}󰝤 {#4}󰝤 {#5}󰝤 {#6}󰝤 {#7}󰝤 {#6}─────────{#}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 7
    }
  ]
}
